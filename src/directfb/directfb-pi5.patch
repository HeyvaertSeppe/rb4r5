+                     void                  *layer_data,
+                     void                  *region_data,
+                     CoreSurface           *surface,
+                     const DFBRegion       *update,
+                     CoreSurfaceBufferLock *lock )
+{
+     D_DEBUG_AT( FBDev_Primary, "%s()\n", __FUNCTION__ );
+
+     if (dfb_fbdev->shared->rot_enable) {
+          static int _updn = 0;
+          if (_updn < 8 && getenv("RB_DFB_DEBUG")) {
+               FILE*f=fopen("/tmp/flipdbg.log","a");
+               if(f){ fprintf(f,"UPDATE %d cfg=%dx%d spitch=%d off=%d\n",
+                              _updn, dfb_fbdev->shared->config.width,
+                              dfb_fbdev->shared->config.height, lock->pitch,
+                              (int)lock->offset); fclose(f); }
+          }
+          _updn++;
+          return publish_rotated_frame( lock );
+     }
+     return DFB_OK;
+}
