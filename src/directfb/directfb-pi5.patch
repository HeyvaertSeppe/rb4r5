+/* Publish the converted/scaled frame into the physical fb (or the shared
+ * shm file in window mode).  Shared by the flip path (full-surface swap)
+ * and the update path (partial/BLIT updates, which is what rbp actually
+ * uses for most redraws) so the frame is always presented regardless of
+ * which path DirectFB's core takes.  On the Pi rotation is 0, but the
+ * RGB565->RGB32 scale/convert is still required, so gate on rot_enable. */
+static DFBResult
+publish_rotated_frame( CoreSurfaceBufferLock *lock )
+{
+     FBDevShared *shared = dfb_fbdev->shared;
+     CoreLayerRegionConfig *config = &shared->config;
+     int sw  = config->width  ? config->width  : 1280;
+     int sh  = config->height ? config->height : 800;
+     int spitch = lock->pitch ? lock->pitch : shared->fix.line_length;
+     RB4R5Dst d;
+
+     if (!shared->rot_enable || !shared->rot_surface)
+          return DFB_OK;
+
+     rb4r5_dst_for_fb( &d, shared, sw, sh );
+
+     /* The first frames black the whole panel: the console has usually left
+      * text on it, and an aspect fit leaves bars that nothing else writes. */
+     if (shared->rot_clear > 0) {
+          shared->rot_clear--;
+          rb4r5_clear( dfb_fbdev->framebuffer_base, &d );
+     }
+
+     /* Always draw into physical buffer 0 and keep the pan at 0.  The DRM
+      * fbdev emulation on the Pi exposes a single buffer, and on the RK3288
+      * the VOP ignored a panned one, so this is right on both.  The frame is
+      * still read from rot_surface + lock->offset (DirectFB cycles its own
+      * buffers); only the destination is pinned. */
+     fbdev_publish_frame( (const unsigned char*)shared->rot_surface + lock->offset,
+                          sw, sh, spitch,
+                          dfb_fbdev->framebuffer_base, &d, shared->rot_deg );
+
+     /* the pixels are already in the fb; panning just selects the buffer.
+      * Don't propagate a pan error - the frame is written either way. */
+     dfb_fbdev_pan( config->source.x, config->source.y, false );
+
+     return DFB_OK;
+}
